{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "The vitest runner does not activate mutants with Vitest 5 (0 tests ran per mutant), so each mutant runs the whole suite through the command runner: correct but slow. The suite itself went from 65.7s to 28.5s when per-file isolation came off, and this run costs roughly mutants x suite, so it followed. Run it from the Mutation workflow, not on your own machine; locally, use --mutate <file> for one file. Incremental mode is on, which only helps a repeated run on the same machine (reports/ is gitignored, and a fresh CI runner has no file to reuse); --force rebuilds it.",
  "testRunner": "command",
  "commandRunner": {
    "command": "npx vitest run --reporter=dot"
  },
  "coverageAnalysis": "off",
  "incremental": true,
  "mutate": [
    "src/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/**/styled.ts",
    "!src/**/*.d.ts",
    "!src/index.tsx",
    "!src/setupTests.ts",
    "!src/features/Homepage/profile.ts",
    "!src/features/Homepage/email.ts",
    "!src/features/Homepage/skillsData.ts",
    "!src/features/Homepage/experienceData.ts",
    "!src/features/Homepage/qualityData.ts",
    "!src/features/Homepage/Portfolio/projectsData.ts",
    "!src/features/Homepage/Portfolio/githubUserName.ts",
    "!src/features/Homepage/Footer/SocialIcons/social.ts",
    "!src/core/App/theme.ts",
    "!src/core/App/GlobalStyle.ts",
    "!src/features/Homepage/ButtonLink/index.ts",
    "!src/features/Homepage/Section/index.ts",
    "!src/features/Homepage/SubHeader/index.ts"
  ],
  "reporters": ["clear-text", "progress", "html", "json"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "jsonReporter": {
    "fileName": "reports/mutation/mutation.json"
  },
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": null
  },
  "timeoutMS": 60000,
  "timeoutFactor": 3,
  "concurrency": 2,
  "tempDirName": ".stryker-tmp"
}
