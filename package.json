{
  "name": "homepage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "homepage": "https://szymonrojek.com/",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build && node scripts/prerender.ts",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:changed": "vitest run --changed",
    "test:e2e": "playwright test",
    "test:e2e:agent": "node scripts/e2e-summary.ts --run",
    "test:e2e:smoke": "playwright test --grep @smoke --retries=0 --reporter=line",
    "test:e2e:flaky": "playwright test --repeat-each=5 --retries=0 --reporter=line",
    "test:e2e:report": "playwright show-report",
    "test:e2e:serve": "npm run build && npm run preview -- --port 4173 --strictPort",
    "test:e2e:changed": "playwright test --only-changed --reporter=line --retries=0",
    "test:lighthouse": "lhci autorun",
    "test:mutation": "stryker run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.13.0",
    "color-alpha": "^2.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.0",
    "styled-components": "^6.6.0",
    "styled-normalize": "^8.1.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.64.1",
    "@stryker-mutator/core": "^10.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.12.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.3"
  }
}
